# ──────────────────────────────────────────────────────────────
# SocialLive configuration
# Copy this file to `.env` and adjust the values.
# NEVER commit your real `.env` to a repository.
# ──────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
# Address the HTTP server binds to.
# Use 127.0.0.1 when running locally behind a tunnel/proxy.
APP_HOST=0.0.0.0
APP_PORT=3000

# Public origin of the deployment (used for OAuth callbacks in a future release).
# APP_BASE_URL=https://your-domain.com

# ── Storage ───────────────────────────────────────────────────
# Root directory for database, videos, thumbnails, logs and keys.
DATA_DIR=./data

# Optional explicit SQLite location. Leave unset to use DATA_DIR/app.db.
# DATABASE_URL=sqlite:./data/app.db

# ── FFmpeg ────────────────────────────────────────────────────
# Leave unset to use `ffmpeg`/`ffprobe` from PATH.
# Windows example: FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Stream encoding profile. Lower the bitrate / use a faster preset on
# weak devices such as Android/Termux (e.g. 2500 + superfast).
FFMPEG_PRESET=veryfast
VIDEO_BITRATE_KBPS=4500
AUDIO_BITRATE_KBPS=128

# ── Security ──────────────────────────────────────────────────
# Session cookie signing secret. If unset, a strong random secret is
# generated and stored under DATA_DIR/config/ on first start.
# SESSION_SECRET=

# Master encryption key for credentials at rest (any long passphrase or
# base64/hex blob). If unset, a random key is generated and stored under
# DATA_DIR/config/encryption.key. Losing this key means losing access to
# stored destination credentials — back it up!
# ENCRYPTION_KEY=

# Set to "true" only for local development/testing to allow streaming to
# private/loopback RTMP targets (SSRF protection bypass).
ALLOW_PRIVATE_RTMP_TARGETS=false

# ── Limits ────────────────────────────────────────────────────
MAX_UPLOAD_SIZE=5368709120        # 5 GB in bytes
MAX_CONCURRENT_STREAMS=4
MAX_RECONNECT_ATTEMPTS=5
RETRY_DELAYS=5,10,20,30,60        # seconds between reconnect attempts
SESSION_TTL_HOURS=168             # 7 days

# ── Logging ───────────────────────────────────────────────────
# One of: debug, info, warn, error
LOG_LEVEL=info
