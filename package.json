{
  "name": "social-live",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, self-hosted, cross-platform live streaming control platform for YouTube and Facebook.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "integrations/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test \"tests/integration/*.test.js\"",
    "start": "node apps/server/dist/index.js",
    "dev:server": "npm run dev -w @social-live/server",
    "dev:web": "npm run dev -w @social-live/web",
    "cli": "node scripts/social-live.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "node-media-server": "^4.4.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
